older.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="新建" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="2" Grid.Row="0" Margin="0,0,8,6" x:Name="AddCropButton" Style="{StaticResource Primary}" Click="AddCrop_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-folder.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="加入选中题目" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="3" Grid.Row="0" Margin="0,0,8,6" x:Name="AddAllRegionsButton" Click="AddAllRegions_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-folder.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="加入全部页选区" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="4" Grid.Row="0" Margin="0,0,8,6" x:Name="UndoRegionButton" Click="UndoRegion_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-undo.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="撤销选区" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="1" Grid.Row="1" Margin="0,0,8,6" x:Name="ClearRegionButton" Click="ClearRegion_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-remove.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="清空选区" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="2" Grid.Row="1" Margin="0,0,8,6" x:Name="SaveCropButton" Click="SaveCrop_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-select.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="保存最后选区" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="3" Grid.Row="1" Margin="0,0,8,6" x:Name="SaveButton" Click="Save_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-save.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="保存整页" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="4" Grid.Row="1" Margin="0,0,8,6" x:Name="ExportPageButton" Click="ExportPage_Click" IsEnabled="False" Padding="9,6"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-pdf.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="导出整页 PDF" VerticalAlignment="Center"/></StackPanel></Button></Grid></ScrollViewer>
