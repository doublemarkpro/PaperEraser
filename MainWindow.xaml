     <Border Grid.Column="4" Style="{StaticResource Card}"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><WrapPanel DockPanel.Dock="Right"><Button Click="ZoomOut_Click" Margin="0,0,3,0" Padding="6,3"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-zoomout.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="－" VerticalAlignment="Center"/></StackPanel></Button><TextBlock x:Name="ZoomText" Text="100%" Width="40" TextAlignment="Center" VerticalAlignment="Center" Foreground="#6C80A0"/><Button Click="ZoomIn_Click" Margin="3,0,0,0" Padding="6,3"><StackPanel Orientation="Horizontal"><Border Background="#F1F7FF" CornerRadius="5" Padding="2" Margin="0,0,6,0"><Border Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="/PaperEraser;component/Assets/generated-zoom.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.13,0.13,0.74,0.74" Stretch="Uniform"/></Border.Background></Border></Border><TextBlock Text="＋" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel><TextBlock Text="处理结果 · 拖动框选" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ScrollViewer x:Name="OutputScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="OutputScroll_SizeChanged"><Viewbox x:Name="OutputView" Stretch="Uniform"><Grid x:Name="ResultSurface" Width="1" Height="1"><Image x:Name="ResultImage" Stretch="Fill"/><Canvas x:Name="SelectionCanvas" Background="Transparent" MouseLeftButtonDown="Selection_Down" MouseMove="Selection_Move" MouseLeftButtonUp="Selection_Up" LostMouseCapture="Selection_LostCapture"><Rectangle x:Name="SelectionRect" Visibili